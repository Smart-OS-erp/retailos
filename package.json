{
  "name": "retailos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:unit": "vitest run tests/unit",
    "test:domain": "vitest run tests/domain",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:live-supabase": "node scripts/security/live-supabase-isolation.ts",
    "test:live-phase0-schema": "node scripts/security/live-phase0-hosted-schema.ts",
    "demo:seed": "node scripts/demo/aso-collective.ts seed",
    "demo:verify": "node scripts/demo/aso-collective.ts verify",
    "demo:reset": "node scripts/demo/aso-collective.ts reset",
    "demo:cleanup": "node scripts/demo/aso-collective.ts cleanup",
    "demo:hosted:provision": "node scripts/demo/hosted-aso.ts provision",
    "demo:hosted:verify": "node scripts/demo/hosted-aso.ts verify",
    "demo:hosted:browser": "node scripts/demo/hosted-aso-browser-smoke.ts",
    "smoke:import-api": "node scripts/security/live-import-api-smoke.ts",
    "migration:hosted-bundle": "node scripts/build-hosted-migration-bundle.ts --write .tmp/phase0-hosted-migration.sql",
    "migration:hosted-phase0-5-bundle": "node scripts/build-hosted-migration-bundle.ts --phase0-5 --write .tmp/phase0-5-hosted-migration.sql",
    "migration:hosted-phase0-5-pending-bundle": "node scripts/build-hosted-migration-bundle.ts --phase0-5-pending --write .tmp/phase0-5-pending-hosted-migration.sql",
    "harness:validate": "node scripts/harness/validate-canonical-state.ts",
    "harness:current-state": "node scripts/harness/generate-current-state.ts",
    "code-health": "node scripts/harness/code-health-scan.ts",
    "security": "node scripts/verify-env.ts && node scripts/security/no-service-role-client.ts && node scripts/security/no-static-dashboard-data.ts && node scripts/security/no-unprotected-api-route.ts && node scripts/security/no-unscoped-supabase-query.ts && node scripts/security/verify-rls-policies.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "26.1.0",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "playwright": "1.62.1",
    "supabase": "2.113.0",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
